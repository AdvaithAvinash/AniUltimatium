{
  // Cloudflare Workers deployment (replaces Vercel). Deploy with:  npm install && npx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aniultimatium",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  // Node-only / native packages are swapped for a stub (they are optional fallbacks)
  "alias": {
    "wreq-js": "./worker/stub.js"
  },
  // Optional: persistent accounts + sync. Wrangler creates the KV namespace automatically on deploy.
  "kv_namespaces": [{ "binding": "STORE" }],
  // "VERCEL" only tells the bundled Anivexa API to skip its local-disk cache (Workers have no disk)
  // ANILIST_CLIENT_ID: id of your AniList API client (https://anilist.co/settings/developer, redirect URL = <site>/link.html)
  "vars": { "VERCEL": "1", "ANILIST_CLIENT_ID": "53471" },
  "observability": { "enabled": true }
}
